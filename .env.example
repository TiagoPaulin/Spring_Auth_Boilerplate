# Copy this file to .env and adjust the values: cp .env.example .env

# PostgreSQL
DB_NAME=springauth
DB_USER=springauth
DB_PASSWORD=change-me

# Secret used to sign JWTs (HMAC256). Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created on first startup
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@springauth.local
ADMIN_PASSWORD=change-me

# Frontend page that receives the reset link as ?token=... and calls POST /auth/reset-password
# RESET_PASSWORD_URL=http://localhost:3000/reset-password

# SMTP used for password reset emails (defaults point to the Mailpit container)
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_FROM=no-reply@springauth.local
